{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tasks": "Host=localhost;Port=5432;Database=tasks;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/"
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "BatchSize": 100,
    "MaxRetryDelay": "00:05:00",
    "ShutdownTimeout": "00:00:05",
    "DegradedAfter": "00:01:00"
  },
  "Idempotency": {
    "KeyLifetime": "1.00:00:00",
    "LockTimeout": "00:00:05",
    "CleanupInterval": "01:00:00"
  }
}
